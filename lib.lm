% Test Script for Lazy Church Naturals
% Load with: :load church_naturals_test.txt

% Basic Church numerals and operations
let zero = \f.\x.x                    % Church numeral 0
let succ = \n.\f.\x.f (n f x)         % Successor function
let one = succ zero                   % Church numeral 1  
let two = succ one                    % Church numeral 2
let three = succ two                  % Church numeral 3
let pred = \n.\f.\x.n (\g.\h.h (g f)) (\u.x) (\u.u)  % Predecessor

% Basic list operations
let pair = \a.\b.\c.c a b             % Pair constructor
let fst = \a.\b.a                     % First projection
let snd = \a.\b.b                     % Second projection

% Map function using thunked self-application
% MapF := λm.λf.λs.pair (f (s fst)) (θ(m m f (!(s snd))))
let MapF = \m.\f.\s.pair (f (s fst)) (?(m m f (!(s snd))))
let map = MapF MapF                   % Fixed-point gives us map

% Method 1: Natural numbers using enumeration from zero
% EnumF := λf.λn.pair n (θ(f f (succ n)))
let EnumF = \f.\n.pair n (?(f f (succ n)))
let enum_from = EnumF EnumF           % Creates streams starting from any number
let nats = enum_from zero             % Natural numbers: 0, 1, 2, 3, ...

% Method 2: Alternative using stream generator pattern  
% StreamF := λf.λstart.pair start (θ(f f (succ start)))
let StreamF = \f.\start.pair start (?(f f (succ start)))
let stream_from = StreamF StreamF
let naturals = stream_from zero       % Same as nats, different implementation

% Test predicates and operations
let is_zero = \n.n (\x.(\a.\b.b)) (\a.\b.a)    % Zero predicate
let add = \m.\n.\f.\x.m f (n f x)              % Addition
let mul = \m.\n.\f.m (n f)                     % Multiplication

% Access helpers for lazy lists
let head = \s.s fst                   % Get first element of stream
let tail = \s.!(s snd)                % Get tail of stream (forced)
let nth = \list.\n.head (n tail list) % Get nth element: apply tail n times, then head
