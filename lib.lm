% Standard library for lazy λμ-calculus
% Load with: :load lib.lm

% Church numerals
let zero  = \f.\x.x
let succ  = \n.\f.\x.f (n f x)
let pred  = \n.\f.\x.n (\g.\h.h (g f)) (\u.x) (\u.u)
let one   = succ zero
let two   = succ one
let three = succ two

% Arithmetic
let is_zero = \n.n (\x.(\a.\b.b)) (\a.\b.a)
let add     = \m.\n.\f.\x.m f (n f x)
let mul     = \m.\n.\f.m (n f)

% Pairs
let pair = \a.\b.\c.c a b
let fst  = \a.\b.a
let snd  = \a.\b.b

% Lazy stream access
let head = \s.s fst
let tail = \s.!(s snd)
let nth  = \s.\n.head (n tail s)

% Stream combinators
let MapF    = \m.\f.\s.pair (f (head s)) (?(m m f (tail s)))
let map     = MapF MapF
let ZipF    = \f.\s1.\s2.pair (pair (head s1) (head s2)) (?(f f (tail s1) (tail s2)))
let zip     = ZipF ZipF
let FilterF = \f.\p.\s.(p (head s)) (pair (head s) (?(f f p (tail s)))) (f f p (tail s))
let filter  = FilterF FilterF
let nil     = \c.\n.n
let TakeF   = \f.\n.\s.is_zero n nil (pair (head s) (?(f f (pred n) (tail s))))
let take    = TakeF TakeF

% Natural number streams
let EnumF     = \f.\n.pair n (?(f f (succ n)))
let enum_from = EnumF EnumF
let nats      = enum_from zero
